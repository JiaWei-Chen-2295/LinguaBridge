NODE_ENV=development
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4318
PUBLIC_GATEWAY_HTTP_URL=http://127.0.0.1:4318
PUBLIC_GATEWAY_WS_URL=ws://127.0.0.1:4318/realtime/sessions

# Gateway model provider. Use mock for local audio/window validation without cloud calls.
MODEL_PROVIDER=mock

# Real Alibaba Cloud provider is only read by apps/gateway, never by the desktop client.
# Set one of these in your local .env when MODEL_PROVIDER=alibaba-cloud.
ALIBABA_MODEL_STUDIO_API_KEY=
DASHSCOPE_API_KEY=
ALIBABA_CLOUD_API_KEY=
# China mainland Model Studio / DashScope endpoints. Use dashscope-intl.aliyuncs.com for international accounts.
ALIBABA_ASR_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
ALIBABA_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_ASR_MODEL=qwen3-asr-flash-realtime
ALIBABA_MT_MODEL=qwen-mt-flash
ALIBABA_ASR_INPUT_AUDIO_FORMAT=pcm
ALIBABA_ASR_VAD_THRESHOLD=0
ALIBABA_ASR_SILENCE_DURATION_MS=400
ALIBABA_TRANSLATE_DRAFTS=false
ALIBABA_REQUEST_TIMEOUT_MS=15000

# Optional Phase 0 comparison switch. Keep disabled unless explicitly running the Spike.
LIVETRANSLATE_SPIKE_ENABLED=false
LIVETRANSLATE_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
LIVETRANSLATE_MODEL=qwen3.5-livetranslate-flash-realtime

OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_BUCKET=lingua-bridge-dev
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_PREFIX=
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=lingua_bridge_minio
MINIO_SECRET_KEY=lingua_bridge_minio_dev
DATABASE_URL=postgresql://lingua_bridge:lingua_bridge_dev@127.0.0.1:5432/lingua_bridge
REDIS_URL=redis://127.0.0.1:6379/0
