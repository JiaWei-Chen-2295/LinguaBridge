NODE_ENV=development
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4318
PUBLIC_GATEWAY_HTTP_URL=http://127.0.0.1:4318
PUBLIC_GATEWAY_WS_URL=ws://127.0.0.1:4318/realtime/sessions

# Mock provider is the only enabled provider in this scaffold.
MODEL_PROVIDER=mock

# Do not put real Alibaba Cloud credentials in client-side env files.
ALIBABA_CLOUD_API_KEY=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=
DATABASE_URL=postgresql://lingua_bridge:lingua_bridge_dev@127.0.0.1:5432/lingua_bridge
REDIS_URL=redis://127.0.0.1:6379/0
