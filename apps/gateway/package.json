{
  "name": "@lingua-bridge/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "build:deps": "npm --prefix ../../packages/mock-models --workspaces=false run build",
    "build": "npm run build:deps && tsc -p tsconfig.json",
    "typecheck": "npm run build:deps && tsc -p tsconfig.json --noEmit",
    "diagnose:config": "tsx src/diagnose-config.ts",
    "dev": "npm run build:deps && tsx src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@lingua-bridge/mock-models": "file:../../packages/mock-models",
    "@lingua-bridge/protocol": "file:../../packages/protocol",
    "fastify": "^5.3.0",
    "minio": "^8.0.7",
    "pg": "^8.21.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
