{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinguaBridge",
  "version": "0.1.0",
  "identifier": "com.linguabridge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LinguaBridge",
        "url": "index.html?window=main",
        "width": 1100,
        "height": 760,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "resizable": true
      },
      {
        "label": "subtitle-overlay",
        "title": "LinguaBridge Subtitles",
        "url": "index.html?window=overlay",
        "width": 980,
        "height": 220,
        "minWidth": 560,
        "minHeight": 140,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
